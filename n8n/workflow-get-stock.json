      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Transforme les lignes Google Sheets en objet JSON plat\n// Chaque ligne : { produit: \"caissettes_5kg\", quantite: 5 }\nconst rows = $input.all();\nconst stock = {};\nfor (const item of rows) {\n  const key = item.json.produit;\n  const val = Number(item.json.quantite);\n  stock[key] = isNaN(val) ? 0 : val;\n}\nreturn [{ json: stock }];"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Formater JSON stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
