      "id": "b2c3d4e5-0003-4000-8000-000000000003",
      "name": "Lire stocks actuels",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [720, 340]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Récupère la commande depuis le webhook\nconst order = $('Webhook POST Commande').first().json;\n\n// Déduit les quantités commandées ligne par ligne\nconst rows = $input.all();\nreturn rows.map(row => {\n  let qty = Number(row.json.quantite) || 0;\n\n  // Déduire 1 caissette si le produit correspond\n  if (order.caissette && row.json.produit === order.caissette) {\n    qty = Math.max(0, qty - 1);\n  }\n\n  // Déduire les steaks hachés\n  if (row.json.produit === 'steaks_haches' && order.steaks_haches_qty > 0) {\n    qty = Math.max(0, qty - Number(order.steaks_haches_qty));\n  }\n\n  return { json: { produit: row.json.produit, quantite: qty } };\n});"
      },
